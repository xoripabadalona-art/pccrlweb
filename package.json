{
  "name": "la-piccerella-web",
  "version": "1.0.0",
  "private": true,
  "description": "La Piccerella — Pizzería artesanal en Badalona. Pizzas grandes y pizzetas con masa fermentada 48 horas.",
  "scripts": {
    "prebuild": "node scripts/check-build.mjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-html-lang.mjs",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:nap": "node scripts/check-nap.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "lenis": "^1.2.3",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
