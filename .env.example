# Required in production builds (build fails with a clear message if missing)
NEXT_PUBLIC_SITE_URL=https://lapiccerella.es

# WhatsApp ordering number in international format without '+' (e.g., 34600000000)
# TODO: Client must confirm a phone number with active WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Delivery flag (default: false — offers pickup only and links to Uber Eats for delivery)
NEXT_PUBLIC_DELIVERY_ENABLED=false

# Optional privacy-friendly analytics (disabled by default)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# Optional: enable canvas frame sequence for ExplodedPizza instead of Option A layered images
NEXT_PUBLIC_USE_FRAME_SEQUENCE=false
